{
  "cli": {
    "version": ">= 19.0.1",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview"
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "env": {
        "IMPOSTER_STORE_BUILD": "true"
      }
    },
    "ads-preview": {
      "extends": "preview",
      "ios": {
        "simulator": true
      },
      "env": {
        "IMPOSTER_ADS_MODE": "test"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6771144493"
      }
    }
  }
}
