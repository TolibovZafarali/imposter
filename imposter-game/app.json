{
  "expo": {
    "name": "IMPOSTER",
    "slug": "imposter-game",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/imposter-icon.png",
    "scheme": "impostergame",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cnfstudios.imposter",
      "buildNumber": "3",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F8FB",
        "foregroundImage": "./assets/images/imposter-logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/imposter-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/imposter-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F8FB",
          "dark": {
            "backgroundColor": "#F7F8FB"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cef249f3-b667-48f8-a009-10987f6d495a"
      }
    },
    "owner": "sw.crxs"
  }
}
